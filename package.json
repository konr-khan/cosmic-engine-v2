{
  "name": "cosmic-engine",
  "version": "2.0.0",
  "type": "module",
  "sideEffects": false,
  "description": "",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "npm run typecheck && npm run lint:units",
    "lint:units": "node scripts/lintUnitSafety.mjs",
    "lint:eslint": "eslint src",
    "check:docs": "node scripts/syncDocMetrics.mjs --check",
    "sync:docs": "node scripts/syncDocMetrics.mjs",
    "sync:dossier": "node scripts/syncDocMetrics.mjs --dossier",
    "verify": "npm run typecheck && npm run lint:units && npm run check:docs && npm run build"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "lucide-react": "^1.16.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  },
  "devDependencies": {
    "@babel/parser": "^7.29.8",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/coverage-v8": "^4.1.10",
    "jsdom": "^31.0.1",
    "postcss": "^8.5.15",
    "tailwindcss": "^4.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.0.13",
    "vitest": "^4.1.11"
  }
}
